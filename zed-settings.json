// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "disable_ai": false,
  "debugger": {
    "dock": "left"
  },
  "cli_default_open_behavior": "existing_window",
  "diff_view_style": "unified",
  "agent": {
    // The right dock holds only this panel, so alt-cmd-j toggles it.
    "default_profile": "ask",
    "dock": "right",
    "default_model": {
      "provider": "anthropic",
      "model": "claude-fable-5-1",
      "enable_thinking": true,
      "effort": "high"
    },
    "button": false,
    "favorite_models": [
      {
        "provider": "anthropic",
        "model": "claude-fable-5-1",
        "enable_thinking": true,
        "effort": "high"
      }
    ],
    "model_parameters": [],
    "threads_sidebar": {
      "auto_open": false,
    },
  },
  "outline_panel": {
    "dock": "left",
  },
  "collaboration_panel": {
    "button": false,
    "dock": "left",
  },
  "project_panel": {
    "dock": "left",
    "starts_open": false,
  },
  "git_panel": {
    "dock": "left",
    // Open the git panel (instead of the file tree) on startup
    "starts_open": true,
  },
  "session": {
    "trust_all_worktrees": true,
  },
  "vim_mode": true,
  "terminal": {
    "font_size": 15.0,
    "copy_on_select": true,
    "max_scroll_history_lines": 100000,
  },
  "git": {
    "inline_blame": {
      "enabled": true,
    },
  },
  "tabs": {
    "activate_on_close": "left_neighbour",
  },
  "relative_line_numbers": "enabled",
  "gutter": {
    "line_numbers": true,
  },
  "minimap": {
    "show": "never",
  },
  "cursor_shape": "block",
  "buffer_font_fallbacks": ["Menlo", "Monaco", "Courier New", "monospace"],
  // NL = no ligatures (keeps != and => as plain characters)
  "buffer_font_family": "JetBrainsMonoNL Nerd Font Mono",
  "wrap_guides": [110],
  "icon_theme": {
    "mode": "system",
    "light": "Zed (Default)",
    "dark": "Zed (Default)",
  },
  "base_keymap": "VSCode",
  "ui_font_size": 19,
  "buffer_font_size": 15,
  "theme": {
    "mode": "system",
    "light": "Ayu Light",
    "dark": "VSCode Nicer Dark High Contrast",
  },
}
