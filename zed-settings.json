// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "debugger": {
    "dock": "left"
  },
  "cli_default_open_behavior": "existing_window",
  "diff_view_style": "unified",
  "agent": {
    "button": false,
    "favorite_models": [],
    "model_parameters": [],
  },
  "outline_panel": {
    "dock": "left",
  },
  "collaboration_panel": {
    "button": false,
    "dock": "right",
  },
  "project_panel": {
    "dock": "left",
    "starts_open": false,
  },
  "git_panel": {
    "dock": "left",
    // Open the git panel (instead of the file tree) on startup
    "starts_open": true,
  },
  "session": {
    "trust_all_worktrees": true,
  },
  "vim_mode": true,
  "terminal": {
    "font_size": 15.0,
    "copy_on_select": true,
    "max_scroll_history_lines": 100000,
  },
  "git": {
    "inline_blame": {
      "enabled": true,
    },
  },
  "tabs": {
    "activate_on_close": "left_neighbour",
  },
  "relative_line_numbers": "enabled",
  "gutter": {
    "line_numbers": true,
  },
  "minimap": {
    "show": "never",
  },
  "cursor_shape": "block",
  "buffer_font_fallbacks": ["Menlo", "Monaco", "Courier New", "monospace"],
  // NL = no ligatures (keeps != and => as plain characters)
  "buffer_font_family": "JetBrainsMonoNL Nerd Font Mono",
  "wrap_guides": [110],
  "icon_theme": {
    "mode": "system",
    "light": "Zed (Default)",
    "dark": "Zed (Default)",
  },
  "base_keymap": "VSCode",
  "ui_font_size": 19,
  "buffer_font_size": 15,
  "theme": {
    "mode": "system",
    "light": "Ayu Light",
    "dark": "Ayu Dark",
  },
  "theme_overrides": {
    "Ayu Dark": {
      // GitHub dark diff gutter colours
      "version_control.added": "#3fb950ff",
      "version_control.modified": "#d29922ff",
      "version_control.deleted": "#f85149ff",
      // Zed derives line backgrounds from the gutter colours; pin them to
      // Ayu's originals (#aad84c / #ef7177 at 15% / 7.5% / 36%, a bit
      // stronger than the default 12% / 6%)
      "editor.diff_hunk.added.background": "#aad84c26",
      "editor.diff_hunk.added.hollow_background": "#aad84c13",
      "editor.diff_hunk.added.hollow_border": "#aad84c5c",
      "editor.diff_hunk.deleted.background": "#ef717726",
      "editor.diff_hunk.deleted.hollow_background": "#ef717713",
      "editor.diff_hunk.deleted.hollow_border": "#ef71775c",
    },
  },
}
