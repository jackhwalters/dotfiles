[
  {
    "context": "Terminal",
    "bindings": {
      "shift-enter": [
        "terminal::SendText",
        "\u001b\r"
      ]
    }
  },
  // Git: cmd-shift-g = panel, ctrl-cmd-d = diff, ctrl-cmd-m = branch diff.
  // Repeated per context because Zed resolves at the deepest matching context,
  // so a Workspace-level binding alone loses to the Editor/Pane defaults.
  {
    "context": "Workspace",
    "bindings": {
      "cmd-shift-g": "git_panel::ToggleFocus",
      "ctrl-cmd-d": "git::Diff",
      "ctrl-cmd-m": "git::DiffBranch"
    }
  },
  {
    "context": "Editor",
    "bindings": {
      "cmd-shift-g": "git_panel::ToggleFocus",
      "ctrl-cmd-d": "git::Diff",
      "ctrl-cmd-m": "git::DiffBranch"
    }
  },
  {
    "context": "Editor && mode == full",
    "bindings": {
      "cmd-shift-g": "git_panel::ToggleFocus",
      "ctrl-cmd-d": "git::Diff",
      "ctrl-cmd-m": "git::DiffBranch"
    }
  },
  {
    "context": "Pane",
    "bindings": {
      "cmd-shift-g": "git_panel::ToggleFocus"
    }
  },
  {
    "context": "BufferSearchBar",
    "bindings": {
      "cmd-shift-g": "git_panel::ToggleFocus"
    }
  },
  {
    "context": "Terminal",
    "bindings": {
      "cmd-shift-g": "git_panel::ToggleFocus",
      "ctrl-cmd-d": "git::Diff",
      "ctrl-cmd-m": "git::DiffBranch"
    }
  },
  {
    "context": "MarkdownPreview",
    "bindings": {
      "cmd-shift-g": "git_panel::ToggleFocus",
      "ctrl-cmd-d": "git::Diff",
      "ctrl-cmd-m": "git::DiffBranch"
    }
  },
  // ctrl-tab / ctrl-shift-tab cycle tabs in order rather than opening the
  // MRU tab switcher (Zed's default "tab_switcher::Toggle").
  {
    "context": "Pane",
    "bindings": {
      "ctrl-tab": "pane::ActivateNextItem",
      "ctrl-shift-tab": "pane::ActivatePreviousItem"
    }
  },
  // jkl; tree navigation (hjkl shifted one key right):
  // j = left/collapse, k = down, l = up, ; = right/expand.
  // vim:: menu actions are required — plain menu:: is a no-op in panels when vim is on.
  {
    "context": "ProjectPanel && not_editing",
    "bindings": {
      "j": "project_panel::CollapseSelectedEntry",
      "k": "vim::MenuSelectNext",
      "l": "vim::MenuSelectPrevious",
      ";": "project_panel::ExpandSelectedEntry"
    }
  },
  {
    "context": "OutlinePanel && not_editing",
    "bindings": {
      "j": "outline_panel::CollapseSelectedEntry",
      "k": "vim::MenuSelectNext",
      "l": "vim::MenuSelectPrevious",
      ";": "outline_panel::ExpandSelectedEntry"
    }
  },
  // Editor vim cursor motion (hjkl shifted one key right):
  // j = left, k = down, l = up, ; = right. Applies in normal/visual/operator modes.
  {
    "context": "VimControl && !menu",
    "bindings": {
      "j": "vim::Left",
      "k": "vim::Down",
      "l": "vim::Up",
      ";": "vim::Right"
    }
  },
  {
    "context": "FileFinder > Picker > Editor",
    "bindings": {
      "tab": "menu::SelectNext",
      "shift-tab": "menu::SelectPrevious"
    }
  },
  {
    "bindings": {
      "f10": "debugger::StepOver"
    }
  },
  {
    "unbind": {
      "f7": "debugger::StepOver"
    }
  },
  {
    "context": "Workspace && debugger_running",
    "bindings": {
      "f11": "debugger::StepInto"
    }
  },
  {
    "bindings": {
      "f12": "debugger::StepOut"
    }
  },
  {
    "bindings": {
      "f11": "debugger::StepInto"
    }
  },
  {
    "unbind": {
      "ctrl-f11": "debugger::StepInto"
    }
  },
  // tab / shift-tab cycle the completion menu. This takes tab away from
  // Zed's default "editor::ComposeCompletion" — use enter to accept instead.
  // Snippet tabstops and eager edit predictions are unaffected: their default
  // contexts already carry "!showing_completions".
  {
    "context": "Editor && showing_completions",
    "bindings": {
      "tab": "editor::ContextMenuNext",
      "shift-tab": "editor::ContextMenuPrevious"
    }
  }
]
